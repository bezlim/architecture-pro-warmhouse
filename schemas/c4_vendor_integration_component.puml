@startuml c4_vendor_component
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title C4 Component Diagram - Vendor Integration Service with Kafka Bus

Container_Boundary(vendor_container, "Vendor Integration Service") {

    Component(api_controller, "API Controller", "REST API + Webhooks", "Обработка HTTP запросов и вебхуки вендоров")

    Component(mqtt_adapter, "MQTT Adapter Component", "Protocol Handler", "Приём данных от устройств через MQTT")

    Component(vendor_adapter, "Vendor Adapter Component", "Protocol Handler", "Интеграция с облаками вендоров (HTTP API)")

    Component(protocol_component, "Protocol Translation Component", "Business Logic", "Трансформация и нормализация данных")

    Component(kafka_producer, "Kafka Producer", "Message Producer", "Публикация телеметрии в Kafka")

    ComponentDb(vendor_db, "Vendor Database", "PostgreSQL", "Конфигурации вендоров, токены, маппинг устройств")
}

Boundary(kafka_boundary, "Kafka", "Message Bus") {
    Component(kafka_bus, "Kafka Bus", "Kafka Topic", "Шина телеметрии и событий")
}

System_Ext(core_service, "Smart Home Core Service", "Устройства, телеметрия, команды")
System_Ext(account_service, "Account & Billing Service", "Валидация пользователей")
System_Ext(vendor_cloud_a, "Device Vendor", "API устройств вендора")
System_Ext(telemetry_ingestion, "Telemetry Ingestion Service", "Потребитель Kafka, валидация, обогащение")

Rel(vendor_cloud_a, api_controller, "Вебхуки событий", "HTTPS/JSON")
Rel(api_controller, vendor_cloud_a, "Запросы API", "HTTPS/JSON")

' Async telemetry flow via Kafka
Rel(mqtt_adapter, kafka_producer, "Публикация телеметрии", "Internal")
Rel(vendor_adapter, kafka_producer, "Публикация событий", "Internal")
Rel(protocol_component, kafka_producer, "Нормализованные данные", "Internal")

Rel(kafka_producer, kafka_bus, "Публикация", "Produce")

Rel(kafka_bus, telemetry_ingestion, "Потребление", "Consume")

Rel(telemetry_ingestion, core_service, "Поток телеметрии", "gRPC/HTTPS")

' Sync commands flow
Rel(core_service, api_controller, "Команды устройствам", "gRPC/HTTPS")

Rel(account_service, api_controller, "Валидация пользователя", "HTTPS/JSON")
Rel(api_controller, mqtt_adapter, "Маршрутизация MQTT", "Internal")
Rel(api_controller, vendor_adapter, "Маршрутизация API вендоров", "Internal")
Rel(api_controller, protocol_component, "Трансформация данных", "Internal")
Rel(mqtt_adapter, vendor_db, "Чтение конфигурации", "SQL")
Rel(vendor_adapter, vendor_db, "Чтение токенов", "SQL")
Rel(protocol_component, vendor_db, "Чтение маппинга", "SQL")
Rel(kafka_producer, vendor_db, "Чтение метаданных", "SQL")

@enduml